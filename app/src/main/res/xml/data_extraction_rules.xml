<?xml version="1.0" encoding="utf-8"?><!--
   Cloud backup keeps library.json (plan and progress) but not the PDFs: they could exceed the 25 MB
   quota, which would stop the whole backup. After a restore the reader asks for the PDF again.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="books" />
    </cloud-backup>
</data-extraction-rules>
